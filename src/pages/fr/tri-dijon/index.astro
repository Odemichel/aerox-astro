---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'AeroX × Tri Dijon — Accès anticipé',
  description: "Mesure ta vraie position aéro chez toi, entraîne-toi à la tenir, et cours en ligne avec ta posture qui compte. Inscris-toi pour l'accès en avant-première réservé aux participants du Tri Dijon.",
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="max-w-5xl mx-auto px-4 py-12 md:py-16">
    <!-- Hero -->
    <div class="text-center mb-14">
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-500 mb-3">AeroX × Tri Dijon — Accès anticipé</p>
      <h1 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-5 leading-tight">
        Combien de minutes tu pourrais gagner<br class="hidden md:block" />
        sur ton prochain triathlon en optimisant ta position ?
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        AeroX mesure ton aéro <strong>en temps réel</strong> sur ton home trainer.
        Pas de soufflerie. Pas de capteurs en plus. 2 minutes pour voir ton CdA bouger
        en changeant de position.
      </p>
    </div>

    <!-- 3 cartes piliers -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">

      <!-- Carte 1 — Mesure -->
      <div class="relative flex flex-col rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-md overflow-hidden">
        <div class="absolute top-4 right-4 z-10">
          <span class="bg-slate-900/80 text-amber-300 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">Automne 2026</span>
        </div>
        <div class="bg-slate-100 dark:bg-slate-700 px-6 py-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400 mb-1">Mesure</p>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Connais ton CdA réel</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Ta vraie traînée aéro, sans soufflerie.</p>
        </div>
        <div class="px-6 py-5 flex flex-col flex-grow">
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-300 flex-grow">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Mesure temps réel sur ton home trainer
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Compare instantanément plusieurs positions
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Setup 2 min, zéro hardware en plus
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Issu de 15 ans de recherche CNRS
            </li>
          </ul>
        </div>
      </div>

      <!-- Carte 2 — Entraînement -->
      <div class="relative flex flex-col rounded-2xl border-2 border-amber-400 bg-white dark:bg-slate-800 shadow-xl overflow-hidden">
        <div class="absolute top-4 right-4 z-10">
          <span class="bg-slate-900/80 text-amber-300 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">Automne 2026</span>
        </div>
        <div class="bg-amber-50 dark:bg-amber-900/20 px-6 py-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400 mb-1">Entraînement</p>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Entraîne-toi à rester aéro</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">L'aéro, ça se travaille — comme la puissance.</p>
        </div>
        <div class="px-6 py-5 flex flex-col flex-grow">
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-300 flex-grow">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Trouve la position qui te fait le plus gagner
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Améliore ton endurance dans cette position
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Deviens puissant <em>dans</em> cette position
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Retour temps réel + suivi de progression
            </li>
          </ul>
        </div>
      </div>

      <!-- Carte 3 — Course en ligne -->
      <div class="relative flex flex-col rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-md overflow-hidden">
        <div class="absolute top-4 right-4 z-10">
          <span class="bg-slate-900/80 text-amber-300 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">Automne 2026</span>
        </div>
        <div class="bg-slate-100 dark:bg-slate-700 px-6 py-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400 mb-1">Course en ligne</p>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Cours en mode aéro</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Les premières courses où ta position compte vraiment.</p>
        </div>
        <div class="px-6 py-5 flex flex-col flex-grow">
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-300 flex-grow">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Simulations de CLM avec ta vraie posture
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              « Dernier homme debout » : résistance asservie à ta position
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Courses en ligne et classements hebdo
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">✓</span>
              Maillots de saison à défendre
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- CTA Formulaire -->
    <div id="inscription" class="max-w-2xl mx-auto rounded-2xl border-2 border-amber-400 bg-white dark:bg-slate-800 shadow-xl p-6 md:p-10">
      <div class="text-center mb-6">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-2">
          Sois prévenu en premier
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300">
          Reçois l'accès dès que la mesure est disponible. Réservé aux participants du Tri Dijon.
        </p>
      </div>

      <form
        id="form-tri-dijon"
        class="flex flex-col gap-4"
        data-success="Merci ! On te contacte dès que l'accès est ouvert."
        data-error="Une erreur est survenue. Réessaie ou écris-nous à contact@aeroxbefaster.com."
      >
        <input
          type="text"
          id="name-tri-dijon"
          name="name"
          placeholder="Prénom"
          required
          autocomplete="given-name"
          class="w-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
        />
        <input
          type="email"
          id="email-tri-dijon"
          name="email"
          placeholder="Email"
          required
          autocomplete="email"
          class="w-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
        />
        <input
          type="tel"
          id="phone-tri-dijon"
          name="phone"
          placeholder="Téléphone (optionnel)"
          autocomplete="tel"
          class="w-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
        />

        <!-- Bloc beta-testeur -->
        <label class="flex items-start gap-3 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 cursor-pointer hover:bg-amber-100 dark:hover:bg-amber-900/30 transition">
          <input
            type="checkbox"
            id="beta-tester-tri-dijon"
            name="betaTester"
            class="mt-1 w-5 h-5 accent-amber-500 cursor-pointer"
          />
          <span class="text-sm text-slate-700 dark:text-slate-200">
            <strong class="block mb-1">Je veux devenir beta-testeur AeroX</strong>
            Tu as essayé AeroX au village du Tri Dijon ? Aide-nous à finaliser les derniers
            réglages : tu auras l'accès en avant-première et tes retours façonneront la version finale.
          </span>
        </label>

        <button
          type="submit"
          class="w-full py-3 rounded-xl bg-amber-400 hover:bg-amber-500 text-amber-900 font-bold text-lg transition shadow-md"
        >
          Je veux savoir en premier
        </button>

        <p class="text-xs text-center text-slate-500 dark:text-slate-400">
          Pas de spam. Tu te désinscris en un clic.
        </p>
        <p id="msg-tri-dijon" class="text-sm text-center mt-2 hidden"></p>
      </form>
    </div>

    <!-- Footer note -->
    <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-10">
      Une question ? Écris-nous à <a href="mailto:contact@aeroxbefaster.com" class="text-amber-500 hover:underline">contact@aeroxbefaster.com</a>
    </p>
  </section>

  <script>
    const form = document.getElementById('form-tri-dijon') as HTMLFormElement | null;
    const msg = document.getElementById('msg-tri-dijon');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (document.getElementById('name-tri-dijon') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email-tri-dijon') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone-tri-dijon') as HTMLInputElement).value.trim();
      const betaTester = (document.getElementById('beta-tester-tri-dijon') as HTMLInputElement).checked;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Envoi en cours…';
      }

      try {
        const res = await fetch('/fr/tri-dijon/api/subscribe/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, betaTester }),
        });

        const data = await res.json();
        msg?.classList.remove('hidden', 'text-red-600', 'text-green-600');

        if (data.success) {
          msg!.textContent = form.dataset.success ?? '';
          msg?.classList.add('text-green-600');
          form.reset();
        } else {
          msg!.textContent = form.dataset.error ?? '';
          msg?.classList.add('text-red-600');
        }
        msg?.classList.remove('hidden');
      } catch (_err) {
        msg!.textContent = form.dataset.error ?? '';
        msg?.classList.add('text-red-600');
        msg?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Je veux savoir en premier';
        }
      }
    });
  </script>
</Layout>
